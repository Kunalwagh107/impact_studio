# ---------------------------------------------------------------------------
# Impact Studio — ignore rules
# ---------------------------------------------------------------------------

# Generated deliverables — regenerated by the app, never committed.
# These are large (one Excel + one PowerPoint per category) and are the *output*
# of a run, so they carry no source information.
outputs/
uploads/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments — the project uses a managed venv outside the tree, but
# guard against a local one being created by accident.
.venv/
venv/
env/
ENV/

# Test / tooling scratch
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# UI probe screenshots — regenerated on every probe run, and there are hundreds
# of them. The probe writes them to whichever directory it is given.
tools/ui_probe/shots*/
tools/ui_probe/*.log

# Headless-Chrome profiles created by the probes. These are large, machine
# specific, and contain browser state.
chrome-probe/
chromeprof*/
.tmp_chrome*/

# Local environment / secrets
.env
.env.*
!.env.example

# Editors and OS cruft
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# NOTE: the reference workbook "TW Impact Study_V2 1 (1).xlsx" is ~39 MB and is
# deliberately NOT ignored here — the verification suites read it directly from
# the project root. If it should stay out of the repository, uncomment the line
# below and keep a copy outside the tree, passing WORKBOOK=<path> to the probes.
# TW Impact Study_V2 1 (1).xlsx
TW Impact Study_V2 1 (1).xlsx

.workbuddy-ai

